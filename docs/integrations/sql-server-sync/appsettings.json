{
  "Askwerk": {
    "BaseUrl": "https://surveys.example.org",
    // An API key with responses:read and surveys:read (Organisation → API). Better: set ASKWERK_API_KEY.
    "ApiKey": "awk_…",
    // Labels in this survey language; leave empty for each survey's default language.
    "Language": "de",
    // Survey ids to copy; empty copies every published survey.
    "Surveys": []
  },
  "SqlServer": {
    // Better: set SQLSERVER_CONNECTION_STRING.
    "ConnectionString": "Server=sql.example.org;Database=Reporting;Integrated Security=true;Encrypt=true"
  }
}
