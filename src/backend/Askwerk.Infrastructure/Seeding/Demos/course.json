            "options": [
              {
                "code": "1",
                "label": {
                  "de": "Vorlesung",
                  "en": "Lectures"
                }
              },
              {
                "code": "2",
                "label": {
                  "de": "Übungen",
                  "en": "Exercises"
                }
              },
              {
                "code": "3",
                "label": {
                  "de": "Lerngruppe",
                  "en": "Study group"
                }
              },
              {
                "code": "4",
                "label": {
                  "de": "Tutorium",
                  "en": "Tutorial"
                }
              },
              {
                "code": "5",
                "label": {
                  "de": "Bücher",
                  "en": "Books"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "overall",
        "title": {
          "de": "Gesamt",
          "en": "Overall"
        },
        "questions": [
          {
            "id": "grade",
            "variable": "GRADE",
            "type": "single",
            "text": {
              "de": "Welche Gesamtnote geben Sie?",
              "en": "Which overall grade do you give?"
            },
            "required": true,
            "key": true,
            "options": [
              {
                "code": "1",
                "label": {
                  "de": "Sehr gut",
                  "en": "Excellent"
                }
              },
              {
                "code": "2",
                "label": {
                  "de": "Gut",
                  "en": "Good"
                }
              },
              {
                "code": "3",
                "label": {
                  "de": "Befriedigend",
                  "en": "Satisfactory"
                }
              },
              {
                "code": "4",
                "label": {
                  "de": "Genügend",
                  "en": "Sufficient"
                }
              },
              {
                "code": "5",
                "label": {
                  "de": "Nicht genügend",
                  "en": "Insufficient"
                }
              }
            ]
          },
          {
            "id": "why",
            "variable": "WHY_LOW",
            "type": "long-text",
            "text": {
              "de": "Was müsste sich ändern?",
              "en": "What would need to change?"
            },
            "required": true,
            "showWhen": {
              "match": "all",
              "conditions": [
                {
                  "question": "grade",
                  "op": "is-one-of",
                  "values": [
                    "4",
                    "5"
                  ]
                }
              ]
            }
          },
          {
            "id": "best",
            "variable": "BEST",
            "type": "long-text",
            "text": {
              "de": "Was war gut?",
              "en": "What was good?"
            },
            "required": false
          }
        ]
      }
    ]
