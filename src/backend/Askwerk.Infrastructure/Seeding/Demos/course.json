    "welcome": {
      "title": {
        "de": "Evaluation: Statistik I, Wintersemester",
        "en": "Evaluation: Statistics I, winter term"
      },
      "text": {
        "de": "Anonym. Die Ergebnisse sehen die Lehrenden erst nach den Noten.",
        "en": "Anonymous. Teachers see the results only after the grades."
      }
    },
    "endPage": {
      "text": {
        "de": "Danke für Ihre Rückmeldung!",
        "en": "Thank you for your feedback!"
      }
    },
    "pages": [
      {
        "id": "you",
        "title": {
          "de": "Zu Ihnen",
          "en": "About you"
        },
        "questions": [
          {
            "id": "programme",
            "variable": "PROGRAMME",
            "type": "single",
            "text": {
              "de": "Ihr Studiengang",
              "en": "Your programme"
            },
            "required": true,
            "options": [
              {
                "code": "1",
                "label": {
                  "de": "Psychologie",
                  "en": "Psychology"
                }
              },
              {
                "code": "2",
                "label": {
                  "de": "Soziologie",
                  "en": "Sociology"
                }
              },
              {
                "code": "3",
                "label": {
                  "de": "Wirtschaft",
                  "en": "Business"
                }
              },
              {
                "code": "4",
                "label": {
                  "de": "Informatik",
                  "en": "Computer science"
                }
              }
            ],
            "other": {
              "code": "99",
              "label": {
                "de": "Sonstiges, bitte angeben:",
                "en": "Other, please specify:"
              },
              "variable": "PROGRAMME_OTHER"
            }
          },
          {
            "id": "semester",
            "variable": "SEMESTER",
            "type": "number",
            "text": {
              "de": "Im wievielten Semester sind Sie?",
              "en": "Which semester are you in?"
            },
            "required": true
          },
          {
            "id": "attended",
            "variable": "ATTENDED",
            "type": "slider",
            "text": {
              "de": "Wie viele Vorlesungen haben Sie besucht (Prozent)?",
              "en": "How many lectures did you attend (percent)?"
            },
            "required": true,
            "scale": {
              "min": 0,
              "max": 100,
              "step": 10,
              "showValue": true
            }
          }
        ]
      },
      {
        "id": "teaching",
        "title": {
          "de": "Lehre",
          "en": "Teaching"
