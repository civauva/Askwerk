            },
            "required": true,
            "scale": {
              "min": 0,
              "max": 20,
              "step": 1,
              "showValue": true
            }
          },
          {
            "id": "level",
            "variable": "LEVEL",
            "type": "rating",
            "text": {
              "de": "Der Schwierigkeitsgrad war …",
              "en": "The difficulty was …"
            },
            "required": true,
            "key": true,
            "scale": {
              "min": 1,
              "max": 5,
              "minLabel": {
                "de": "viel zu leicht",
                "en": "far too easy"
              },
              "maxLabel": {
                "de": "viel zu schwer",
                "en": "far too hard"
              }
            }
          },
          {
