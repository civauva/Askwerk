            "options": [
              {
                "code": "1",
                "label": {
                  "de": "Schlecht",
                  "en": "Poor"
                }
              },
              {
                "code": "2",
                "label": {
                  "de": "Mittel",
                  "en": "Fair"
                }
              },
              {
                "code": "3",
                "label": {
                  "de": "Gut",
                  "en": "Good"
                }
              },
              {
                "code": "4",
                "label": {
                  "de": "Sehr gut",
                  "en": "Very good"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "workload",
        "title": {
          "de": "Aufwand",
          "en": "Workload"
        },
        "questions": [
          {
            "id": "hours",
            "variable": "HOURS",
            "type": "slider",
