# SPDX-License-Identifier: AGPL-3.0-only
# Copy to .env next to docker-compose.yml. Only secrets and the few values needed before the
# app starts live here; everything else is configured in the app and stored in the database.
# Leave a secret empty and Askwerk generates it on first start (and tells you to back it up).

# Images. Change these to pull from your own registry; `docker compose up --build` needs no registry.
ASKWERK_IMAGE=ghcr.io/civauva/askwerk:latest
ASKWERK_PROXY_IMAGE=caddy:2

# Port Askwerk listens on (plain HTTP). Put any reverse proxy in front, or use --profile caddy.
ASKWERK_HTTP_PORT=8080

# Public address of this instance, used in links and e-mails until the setup wizard sets the base domain.
ASKWERK_BASE_URL=http://localhost:8080

# Database password for the bundled PostgreSQL.
POSTGRES_PASSWORD=

# Key that encrypts secrets stored in the database (SMTP password, OIDC secrets, token signing key).
# Losing it means re-entering those secrets. Generate with: openssl rand -base64 32
ASKWERK_DATA_KEY=

# Optional: OTLP endpoint for logs, metrics and traces (agents/observability.md). Needs a restart.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional: installation settings fixed here instead of in the app (Administration → Installation shows them locked).
# Leave empty to manage them in the app. Any ASKWERK_SMTP_* value locks the whole email group.
ASKWERK_NAME=
ASKWERK_LANGUAGE=
ASKWERK_TIME_ZONE=
ASKWERK_SMTP_HOST=
ASKWERK_SMTP_PORT=
ASKWERK_SMTP_USER=
ASKWERK_SMTP_PASSWORD=
ASKWERK_SMTP_SENDER=
